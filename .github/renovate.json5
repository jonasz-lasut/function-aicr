{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Workflows pin every action to a commit SHA with a `# vX.Y.Z` comment;
    // keep it that way and resolve the comment to a full semver tag.
    'helpers:pinGitHubActionDigestsToSemver',
    // The repo uses conventional commits; a routine bump is a chore, not a fix.
    ':semanticCommitTypeAll(chore)',
  ],
  // config:recommended ignores every path with a `test` directory in it,
  // which would leave the end-to-end suite's own Go module (test/e2e/go.mod)
  // without updates. Nothing in this repository is vendored or generated
  // from another package manager, so nothing needs ignoring.
  ignorePaths: [],
  // The dependency surfaces: go.mod, the workflows (actions and the CLI
  // versions in their env), the Function package refs under example/, and
  // the Dockerfile. go.mod is the single source of truth for the Go version
  // (workflows read it), so the golang build stage floats on golang:1 by
  // design; the runtime base (gcr.io/distroless/static-debian13:nonroot) is
  // digest-pinned and the dockerfile manager keeps that digest current.
  enabledManagers: ['gomod', 'github-actions', 'crossplane', 'dockerfile', 'git-submodules', 'custom.regex'],
  // CI's check-diff runs `go mod tidy` and fails on a dirty tree, so tidy in
  // the same commit; update import paths on /vN major bumps.
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  osvVulnerabilityAlerts: true,
  crossplane: {
    // Function/Provider package refs in the render example (function-auto-ready).
    managerFilePatterns: ['/^example/.*\\.ya?ml$/'],
  },
  customManagers: [
    {
      // golangci-lint version pinned in the CI workflow env.
      customType: 'regex',
      description: 'GOLANGCI_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["GOLANGCI_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'golangci/golangci-lint',
      datasourceTemplate: 'github-releases',
    },
    {
      // Vale version the docs workflow installs; its checksum comes from the
      // release's own checksum file, so only the version is pinned.
      customType: 'regex',
      description: 'VALE_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["VALE_VERSION: '(?<currentValue>[^']+)'"],
      depNameTemplate: 'errata-ai/vale',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // What the end-to-end cluster installs: the Makefile's pins, each under
      // a `# renovate: datasource=... depName=...` comment. An optional
      // extractVersion strips the `v` where the pin is a chart version.
      customType: 'regex',
      description: 'pins under a renovate comment in the Makefile',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\n[A-Z_]+ \\?= (?<currentValue>\\S+)',
      ],
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{/if}}',
    },
    {
      // Crossplane CLI version installed by install.sh in the release workflows.
      // Since v2.3.0 the CLI is released from crossplane/cli (XP_CHANNEL=stable).
      customType: 'regex',
      description: 'XP_VERSION in .github/workflows',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: ["XP_VERSION: '(?<currentValue>v[^']+)'"],
      depNameTemplate: 'crossplane/cli',
      datasourceTemplate: 'github-releases',
    },
  ],
  // Rules are evaluated in order; later rules win.
  packageRules: [
    // Catch-all: every remaining Go module lands in one PR.
    { matchManagers: ['gomod'], groupName: 'go modules' },

    // Non-major updates merge on their own once CI is green. Renovate merges a
    // grouped PR only when every update in it is automergeable, so the list
    // covers the digest and pin updates of the github-actions group too. The
    // rules below opt out what needs a human: aicr and the approval-gated
    // Kubernetes minors. Majors and the runtime image digest (dockerfile
    // manager, built by no PR check) stay manual.
    {
      matchManagers: ['gomod', 'github-actions', 'crossplane', 'custom.regex'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      automerge: true,
    },

    // Kubernetes staging modules and controller-tools move together. Their
    // minor version follows what crossplane-runtime / function-sdk-go pull in,
    // so only patches flow freely; minors and majors wait for approval on the
    // dependency dashboard.
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['k8s.io/**', 'sigs.k8s.io/controller-runtime', 'sigs.k8s.io/controller-tools'],
      groupName: 'kubernetes',
    },
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['k8s.io/**', 'sigs.k8s.io/controller-runtime', 'sigs.k8s.io/controller-tools'],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
      automerge: false,
    },

    // Crossplane SDK modules are released together and depend on each other.
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/crossplane/**'],
      groupName: 'crossplane',
    },

    // aicr.run (AICR's Go module) *is* the recipe catalog: bumping it changes what
    // the function deploys, always ships as a minor release from main, and needs
    // `go generate ./...` plus a review of test-fixtures/want/ and the example
    // renders (AGENTS.md, "Bumping the AICR module"). Surface new versions on
    // the dashboard and open the PR only on approval, never in a bulk PR.
    {
      matchManagers: ['gomod'],
      matchDepNames: ['aicr.run'],
      groupName: 'aicr',
      dependencyDashboardApproval: true,
      automerge: false,
    },

    // The go directive is the Go version CI builds and tests with (setup-go and
    // the runtime image read go.mod), so bump it — Go patch releases carry the
    // toolchain security fixes. Renovate leaves it alone unless told to bump.
    {
      matchManagers: ['gomod'],
      matchDepNames: ['go'],
      matchDepTypes: ['golang'],
      rangeStrategy: 'bump',
      groupName: 'go',
    },

    // GitHub Actions: let a release settle before pulling its digest, batch
    // non-major bumps into one PR, and keep majors as separate PRs since they
    // tend to need workflow changes.
    { matchManagers: ['github-actions'], minimumReleaseAge: '3 days' },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github-actions',
    },

    // The end-to-end suite: the cluster's pins in the Makefile, the suite's
    // own Go module and the build submodule. The suite runs on every pull
    // request but is not a required check, so GitHub's auto-merge would not
    // wait for it: merge these once the suite is green.
    {
      matchFileNames: ['Makefile', 'test/e2e/**'],
      groupName: 'e2e',
      automerge: false,
    },
    { matchManagers: ['git-submodules'], groupName: 'build submodule', automerge: false },

    // Package refs in the render example.
    { matchManagers: ['crossplane'], groupName: 'examples' },

    // Dockerfile: the golang build stage follows go.mod, not Renovate; the
    // runtime base is pinned to a digest that moves with distroless's
    // rebuilds of the `nonroot` tag — one PR per digest bump, so a rebuild
    // that breaks the image is judged on its own.
    { matchManagers: ['dockerfile'], matchPackageNames: ['golang'], enabled: false },
    {
      matchManagers: ['dockerfile'],
      matchPackageNames: ['gcr.io/distroless/static-debian13'],
      pinDigests: true,
      groupName: 'runtime image',
    },
  ],
}
